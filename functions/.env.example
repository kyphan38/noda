# Cloud Functions runtime config (server-side only - never NEXT_PUBLIC_*).
# Set the real values as Cloud Functions secrets, not in a committed file:
#   firebase functions:secrets:set GEMINI_API_KEY
#   firebase functions:secrets:set ALLOWED_USER_UID
#
# Same Gemini API key as /Users/kyphan/ws/cogi (web/.env.example).
GEMINI_API_KEY=
# Model: gemini-3.8-flash - the one model every app in this workspace runs on.
# Optional override, defaults to gemini-3.8-flash in code.
GEMINI_MODEL=gemini-3.8-flash

# Mirrors NEXT_PUBLIC_ALLOWED_USER_UID from the noda frontend - used server-side
# to reject calls from anyone other than the single allowlisted user.
ALLOWED_USER_UID=
