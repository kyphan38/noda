rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Single-user app: only this verified Google account may use the bucket.
    function allowed() {
      return request.auth != null
        && request.auth.token.email == 'kyphan.work@gmail.com'
        && request.auth.token.email_verified == true;
    }

    // Same limits as lib/lessonFiles.ts (MEDIA_MAX_BYTES) and the MIME map in lib/db.ts.
    function validMedia() {
      return request.resource.size < 200 * 1024 * 1024
        && request.resource.contentType.matches('audio/.*|video/(mp4|webm|quicktime)');
    }

    match /users/{userId}/media/{allPaths=**} {
      allow read, delete: if allowed() && request.auth.uid == userId;
      allow create, update: if allowed() && request.auth.uid == userId && validMedia();
    }

    // Talk Time Capsule: one short voice recording per month.
    match /users/{userId}/talkCapsules/{file} {
      allow read, delete: if allowed() && request.auth.uid == userId;
      allow create, update: if allowed() && request.auth.uid == userId
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('audio/.*');
    }

    // Own background music tracks. Same limits as lib/db/bgm.ts (MAX_BG_TRACK_BYTES).
    match /users/{userId}/bgm/{file} {
      allow read, delete: if allowed() && request.auth.uid == userId;
      allow create: if allowed() && request.auth.uid == userId
        && request.resource.size < 30 * 1024 * 1024
        && request.resource.contentType.matches('audio/.*');
    }

    // Background music tracks: uploaded by scripts/upload-bgm.sh, read-only from the app.
    match /defaults/bgm/{file} {
      allow read: if allowed();
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
