rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Single-user app: only this verified Google account may use the database.
    function allowed() {
      return request.auth != null
        && request.auth.token.email == 'kyphan.work@gmail.com'
        && request.auth.token.email_verified == true;
    }
    function isOwner(uid) {
      return allowed() && request.auth.uid == uid;
    }
    match /users/{userId}/lessons/{lessonId} {
      allow read, write: if isOwner(userId);
    }
    match /users/{userId}/sidebarFolders/{folderId} {
      allow read, write: if isOwner(userId);
    }
    // Dictation misses per lesson, for the Mistakes page.
    match /users/{userId}/misses/{lessonId} {
      allow read, write: if isOwner(userId);
    }
    // Word cards: written by defineWord only; read to build a lesson's Talk topic.
    match /users/{userId}/words/{wordId} {
      allow read: if isOwner(userId);
      allow write: if false;
    }
    // Heavy half of a lesson (transcript, drafts, progress), read only when it opens.
    match /users/{userId}/lessons/{lessonId}/content/{docId} {
      allow read, write: if isOwner(userId);
    }
    // Talk: the talkTopic function creates a topic; the app hides phrases and deletes topics.
    match /users/{userId}/talkTopics/{topicId} {
      allow read, update, delete: if isOwner(userId);
      allow create: if false;
    }
    match /users/{userId}/talkSessions/{sessionId} {
      allow read, write: if isOwner(userId);
    }
    // Where you stopped in Learn, per topic and set.
    match /users/{userId}/talkLearnState/{key} {
      allow read, write: if isOwner(userId);
    }
    match /users/{userId}/talkCapsules/{month} {
      allow read, write: if isOwner(userId);
    }
    match /users/{userId}/talkCaptures/{captureId} {
      allow read, write: if isOwner(userId);
    }
    match /users/{userId}/talkMistakes/{pattern} {
      allow read, write: if isOwner(userId);
    }
    match /users/{userId}/talkPhraseProgress/{progressId} {
      allow read, write: if isOwner(userId);
    }
    match /users/{userId}/lessons/{lessonId}/shadowingAnalysis/{sentenceId} {
      allow read: if isOwner(userId);
      allow write: if false; // only Cloud Function (Admin SDK) writes here
    }
    match /users/{userId}/lessons/{lessonId}/speakingAttempts/{attemptId} {
      allow read: if isOwner(userId);
      allow write: if false; // only Cloud Function (Admin SDK) writes here
    }

    // The Speaking page reads every lesson's attempts in one collection-group query.
    // The only allowed account owns them all; the app keeps only its own path.
    match /{path=**}/speakingAttempts/{attemptId} {
      allow read: if allowed();
    }

    // AI cost per month (YYYY-MM). Written by the server only (Admin SDK).
    match /aiUsage/{month} {
      allow read: if allowed();
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
