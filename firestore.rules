rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId}/lessons/{lessonId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    match /users/{userId}/sidebarFolders/{folderId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    match /users/{userId}/lessons/{lessonId}/shadowingAnalysis/{sentenceId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false; // only Cloud Function (Admin SDK) writes here
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
